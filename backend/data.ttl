kul:KalimantanTengah a kul:Daerah ; rdfs:label "Kalimantan Tengah" .
kul:KalimantanSelatan a kul:Daerah ; rdfs:label "Kalimantan Selatan" .
kul:KalimantanTimur a kul:Daerah ; rdfs:label "Kalimantan Timur" .
kul:KalimantanUtara a kul:Daerah ; rdfs:label "Kalimantan Utara" .
kul:SulawesiUtara a kul:Daerah ; rdfs:label "Sulawesi Utara" .
kul:Gorontalo a kul:Daerah ; rdfs:label "Gorontalo" .
kul:SulawesiTengah a kul:Daerah ; rdfs:label "Sulawesi Tengah" .
kul:SulawesiBarat a kul:Daerah ; rdfs:label "Sulawesi Barat" .
kul:SulawesiSelatan a kul:Daerah ; rdfs:label "Sulawesi Selatan" .
