kul:Maluku a kul:Daerah ; rdfs:label "Maluku" .
kul:MalukuUtara a kul:Daerah ; rdfs:label "Maluku Utara" .
kul:Papua a kul:Daerah ; rdfs:label "Papua" .
kul:PapuaBarat a kul:Daerah ; rdfs:label "Papua Barat" .
kul:PapuaSelatan a kul:Daerah ; rdfs:label "Papua Selatan" .
