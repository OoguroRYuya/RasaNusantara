@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix kul: <http://nusantara.org/ontology/kuliner#> .

# ==========================================
# Ontology Classes
# ==========================================
kul:Makanan a rdfs:Class ; rdfs:label "Makanan Tradisional" .
kul:Daerah a rdfs:Class ; rdfs:label "Daerah" .
kul:Bahan a rdfs:Class ; rdfs:label "Bahan Baku" .

# ==========================================
# Ontology Properties
# ==========================================
kul:namaIstilah a rdf:Property ;
    rdfs:domain kul:Makanan ;
    rdfs:range rdfs:Literal .

kul:asalDaerah a rdf:Property ;
    rdfs:domain kul:Makanan ;
    rdfs:range kul:Daerah .

kul:etimologi a rdf:Property ;
    rdfs:domain kul:Makanan ;
    rdfs:range rdfs:Literal .

kul:bahanUtama a rdf:Property ;
    rdfs:domain kul:Makanan ;
    rdfs:range kul:Bahan .

